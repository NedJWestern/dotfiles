# Define the config directory
BASH_CONFIG_DIR="$HOME/.config/bash"

# source all config files
for config_file in "$BASH_CONFIG_DIR"/*; do
    # Don't source this file
    if [ "$config_file" != "$BASH_CONFIG_DIR/bashrc" ]; then
        . "$config_file"
    fi
done

# Clean up the variable
unset config_file

# equivalent to `ignorespace:ignoredups`
export HISTCONTROL=ignoreboth
export EDITOR=nvim VISUAL=nvim

# vi editing, with jk to leave insert mode as in vim. Interactive shells only:
# bind warns when there's no line editor.
if [[ $- == *i* ]]; then
    set -o vi
    bind -m vi-insert '"jk": vi-movement-mode'
    # prefix the prompt with (ins) or (cmd)
    bind 'set show-mode-in-prompt on'
    # fzf keys: ctrl+r history, ctrl+t file path, alt+c cd. fzf < 0.48 has no
    # --bash, but Debian ships the same script. After set -o vi, which it reads.
    eval "$(fzf --bash 2>/dev/null || cat /usr/share/doc/fzf/examples/key-bindings.bash 2>/dev/null)"
    # z <part of a dir> jumps to the best match among dirs visited before
    command -v zoxide >/dev/null && eval "$(zoxide init bash)"
fi
# green blue yellow
PS1='\[\e[0;32m\]\u\[\e[0m\]@\[\e[0;34m\]\h\[\e[0m\] \[\e[0;33m\]\W\[\e[0m\] \$ '


# Convert Windows backslashes in clipboard to forward slashes
fslash() {
    cat /dev/clipboard | tr '\\' '/' > /dev/clipboard
    echo "Clipboard updated: $(cat /dev/clipboard)"
}

pps() {
  { printf 'ID\tIMAGE\tSTATUS\tPORTS\tNAMES\n'
    podman ps "$@" \
        --all \
        --sort names \
        --format '{{.ID}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}\t{{.Names}}'
  } | awk -F'\t' -v OFS='\t' '{sub(/.*\//,"",$2); for(i=1;i<=NF;i++) if($i=="") $i="-"} 1' \
    | column -t -s $'\t'
}

